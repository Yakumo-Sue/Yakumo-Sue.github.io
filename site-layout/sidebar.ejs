<% if (is_home()) { %>
<aside class="yakumo-sidebar" aria-label="博客信息">
  <section class="yakumo-side-card yakumo-profile">
    <div class="yakumo-avatar" aria-hidden="true">
      <svg viewBox="0 0 64 64" fill="none"><path d="M5 49 24 21l9 14 9-11 17 25H5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m14 36 10-15 8 12m8-6 2-3 5 7" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="47" cy="14" r="4" fill="currentColor"/></svg>
    </div>
    <h2>八云</h2>
    <small>LIFE IS A JOURNEY</small>
    <p>一个收集灵感、慢慢写字的人。<br>在这里，与日常温柔相遇。</p>
    <div class="yakumo-stats">
      <a href="<%= url_for('/archives/') %>"><strong><%= site.posts.length %></strong><span>文章</span></a>
      <a href="<%= url_for('/categories/') %>"><strong><%= site.categories.length %></strong><span>分类</span></a>
      <a href="<%= url_for('/tags/') %>"><strong><%= site.tags.length %></strong><span>标签</span></a>
    </div>
    <a class="yakumo-profile-link" href="<%= url_for('/about/') %>">关于我 <span aria-hidden="true">→</span></a>
  </section>

  <section class="yakumo-side-card">
    <h2 class="yakumo-side-title">✦ 小站公告</h2>
    <p>欢迎来到这间数字小屋。<br>愿文字能留住一点日常，也为你带来一点灵感。</p>
    <small>初次见面，请多关照 ☺</small>
  </section>

  <section class="yakumo-side-card yakumo-calendar" aria-label="文章日历" data-posts="<%= JSON.stringify(site.posts.toArray().map(function (post) { return { date: post.date.format('YYYY-MM-DD'), url: url_for(post.path), title: post.title }; })) %>">
    <div class="yakumo-calendar-header">
      <h2 class="yakumo-side-title">▦ 记录日历</h2>
      <div class="yakumo-calendar-nav">
        <button type="button" class="yakumo-calendar-prev" aria-label="上个月">‹</button>
        <span class="yakumo-calendar-month" aria-live="polite"></span>
        <button type="button" class="yakumo-calendar-next" aria-label="下个月">›</button>
      </div>
    </div>
    <div class="yakumo-calendar-weekdays" aria-hidden="true"><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span></div>
    <div class="yakumo-calendar-days" role="grid" aria-label="文章发表日期"></div>
    <small>标记日期有文章，点击即可阅读。</small>
  </section>

  <section class="yakumo-side-card">
    <h2 class="yakumo-side-title">▤ 文章分类</h2>
    <ul class="yakumo-category-list">
      <% site.categories.each(function (item) { %>
        <li><a href="<%= url_for(item.path) %>"><span><%= item.name %></span><small><%= item.length %></small></a></li>
      <% }) %>
    </ul>
  </section>

  <section class="yakumo-side-card">
    <h2 class="yakumo-side-title"># 标签漫游</h2>
    <div class="yakumo-tag-list">
      <% site.tags.toArray().slice(0, 9).forEach(function (item) { %>
        <a href="<%= url_for(item.path) %>"># <%= item.name %></a>
      <% }) %>
      <a class="yakumo-all-tags" href="<%= url_for('/tags/') %>">全部标签 →</a>
    </div>
  </section>

  <section class="yakumo-quote"><span aria-hidden="true">“</span><p>在平凡的日子里，<br>发现不平凡的微光。</p><small>A NOTE TO SELF</small></section>
  <a class="yakumo-rss" href="<%= url_for('/feed.xml') %>">◌ 通过 RSS 订阅手记</a>
</aside>
<% } %>
